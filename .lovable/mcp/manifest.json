      {
        "name": "flag_content_for_review",
        "title": "Flag content for review",
        "description": "Log a review verdict on a QBank question, assessment item, ATLAS conversation, or course quiz. Records reviewer, verdict, severity, sources cross-checked, and notes to the content_reviews audit trail.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "content_type": {
              "type": "string",
              "enum": [
                "qbank_question",
                "assessment_item",
                "atlas_conversation",
                "course_quiz"
              ]
            },
            "content_id": {
              "type": "string",
              "description": "question_id, UUID, or conversation_id."
            },
            "verdict": {
              "type": "string",
              "enum": [
                "approved",
                "needs_revision",
                "rejected",
                "flagged"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "default": "medium"
            },
            "reason": {
              "type": "string",
              "description": "Short category, e.g. 'incorrect answer', 'outdated guideline', 'weak distractors'."
            },
            "sources_checked": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Sources cross-referenced, e.g. ['First Aid 2024 p.312', 'UpToDate: STEMI', 'AHA 2023 guideline']."
            },
            "notes": {
              "type": "string",
              "description": "Detailed rationale."
            }
